<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="StayFocused.InputDialog"
        Title="Input Dialog" SizeToContent="WidthAndHeight" ResizeMode="NoResize" av:DesignHeight="133.815" av:DesignWidth="338.061">
    <StackPanel Margin="15">
        <TextBlock x:Name="PromptTextBlock" Margin="0 0 10 0" />
        <TextBox x:Name="inputTextBox" Margin="0 0 0 10" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Click="OnOkClick" Margin="0 0 5 0" />
            <Button Content="Cancel" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
