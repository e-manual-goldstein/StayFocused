<Window x:Class="StayFocused.GUI.DailySummary"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StayFocused"
        Title="Daily Summary" Height="800" Width="1000">
    <Window.Resources>
        <ContextMenu x:Key="ColumnContextMenu">
            
        </ContextMenu>
    </Window.Resources>
    <Grid>
        <ListView Name="ActivityListView" ItemsSource="{Binding Activities}">
            <ListView.View>
                <GridView>
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="{x:Type GridViewColumnHeader}">
                            <Setter Property="ContextMenu" Value="{x:Null}" />
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>
                    <GridViewColumn Header="Process Name" Width="200" DisplayMemberBinding="{Binding ProcessName}" />
                    <GridViewColumn Header="Window Title" Width="200" DisplayMemberBinding="{Binding WindowTitle}" />
                    <GridViewColumn Header="Total Duration" Width="200" DisplayMemberBinding="{Binding TotalDuration}" />
                    <GridViewColumn Header="Is Selected">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>                    
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
