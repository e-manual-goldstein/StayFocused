<Window x:Class="StayFocused.GUI.DailySummary"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily Summary" Height="400" Width="600">
    <Grid>
        <ListView Name="ActivityListView" ItemsSource="{Binding Activities}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding ProcessName}" />
                    <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding WindowTitle}" />
                    <GridViewColumn Header="Timespan" Width="200" DisplayMemberBinding="{Binding TotalDuration}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
