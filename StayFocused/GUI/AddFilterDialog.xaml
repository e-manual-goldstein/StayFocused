<Window x:Class="StayFocused.AddFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Filter" Height="180" Width="320">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Filter Type Radio Buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <RadioButton x:Name="StartsWithRadioButton" Content="Starts With" IsChecked="True" />
            <RadioButton x:Name="ContainsRadioButton" Content="Contains" />
            <RadioButton x:Name="EndsWithRadioButton" Content="Ends With" />
        </StackPanel>

        <!-- Text Input Field with Label -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="5">
            <Label Content="Enter filter text..." HorizontalAlignment="Left" />
            <TextBox x:Name="FilterTextBox" Margin="0,5,0,0" />
        </StackPanel>

        <!-- Buttons (OK and Cancel) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="OK" Click="OKButton_Click" Width="75" />
            <Button Content="Cancel" Click="CancelButton_Click" Width="75" />
        </StackPanel>
    </Grid>
</Window>
